# ========================================================
# Cineaste — Environment Variables Specification
# Note: For Phase 1 (Shell & Foundation), no live API keys
# are required. These are prepared for Phases 2 & 3.
# ========================================================

# Supabase Auth & Database (Phase 2)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# TMDB API Gateway (Phase 3)
TMDB_API_KEY=your-tmdb-v3-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3

# Google Gemini API for Vibe Search (Phase 3)
GEMINI_API_KEY=your-gemini-api-key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
